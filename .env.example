# --- Database ---
# Owner role: runs migrations and rls.sql
DATABASE_URL_MIGRATE="postgresql://lms:lms@localhost:5432/lms"
# App role: subject to row-level security (created by packages/db/prisma/sql/rls.sql)
DATABASE_URL="postgresql://lms_app:lms_app@localhost:5432/lms"
# Platform role: BYPASSRLS, used only by platform-admin, auth and webhook code
DATABASE_URL_PLATFORM="postgresql://lms_platform:lms_platform@localhost:5432/lms"

# --- Security ---
JWT_SECRET="change-me-to-a-long-random-string-32+"
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- URLs ---
# Institutes live on <slug>.PLATFORM_HOST. Browsers resolve *.localhost to this machine.
PLATFORM_HOST="localhost"
APP_URL_TEMPLATE="http://{slug}.localhost:3000"
PLATFORM_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
PORT=4000

# --- Integrations ---
REDIS_URL="redis://localhost:6379"
# STORAGE_DRIVER=local keeps files in LOCAL_STORAGE_DIR instead (development only, no MinIO needed).
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=.storage
# On AWS: leave S3_ENDPOINT and the keys empty (the IAM role is used) and S3_FORCE_PATH_STYLE=false
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="lms-private"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio12345"
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=500
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="Coaching LMS <no-reply@example.com>"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PLATFORM_GST_RATE=18
